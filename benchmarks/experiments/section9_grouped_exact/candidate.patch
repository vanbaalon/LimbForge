@@ -0,0 +1,21 @@
+"""Clone unchanged single-band arithmetic; add independent-trial address/grid offsets."""
+from pathlib import Path
+import hashlib
+root=Path(__file__).resolve().parents[3]
+s=(root/'src/linalg.metal').read_text()
+preamble=s[:s.index('kernel void digits_left')]
+left=s[s.index('kernel void digits_left'):s.index('// Right band')]
+product=s[s.index('inline uint reduce(int g'):s.index('// SUB (pipeline specialisation)')]
+rec=s[s.index('// SUB (pipeline specialisation)'):s.index('// Multi-band outputs:')]
+control='struct GroupShape { uint trials,planes; };\n'
+left=left.replace('kernel void digits_left','kernel void grouped_digits_left').replace('uint3 g [[thread_position_in_grid]]){','constant GroupShape& shape [[buffer(16)]],uint3 global [[thread_position_in_grid]]){\n    const uint groups=(p.group+LF_GROUP-1)/LF_GROUP,q=global.z/groups;\n    if(q>=shape.trials)return;uint3 g=uint3(global.xy,global.z%groups);\n    const ulong group_hp=ulong(p.Mp)*p.Kp;\n    src+=ulong(q)*p.K*p.out_cols;band+=ulong(q)*p.out_cols;\n    cat+=ulong(q)*shape.planes*2*group_hp;d1+=ulong(q)*shape.planes*group_hp;d0+=ulong(q)*shape.planes*group_hp;rcat+=ulong(q)*shape.planes*2*group_hp;')
+product=product.replace('kernel void product_residue','kernel void grouped_product_residue').replace('uint3 tgid [[threadgroup_position_in_grid]]){','constant GroupShape& shape [[buffer(16)]],uint3 global [[threadgroup_position_in_grid]]){\n    const uint q=global.z/p.group;if(q>=shape.trials)return;uint3 tgid=uint3(global.xy,global.z%p.group);\n    const ulong group_hp=ulong(p.Mp)*p.Kp;\n    lcat+=ulong(q)*shape.planes*2*group_hp;a1+=ulong(q)*shape.planes*group_hp;a0+=ulong(q)*shape.planes*group_hp;rcat+=ulong(q)*shape.planes*2*group_hp;\n    res+=ulong(q)*p.L*p.Mp*p.Np;')
+rec=rec.replace('kernel void reconstruct','kernel void grouped_reconstruct').replace('uint2 g [[thread_position_in_grid]]){','constant GroupShape& shape [[buffer(16)]],uint3 global [[thread_position_in_grid]]){\n    const uint q=global.z;if(q>=shape.trials)return;uint2 g=global.xy;\n    res+=ulong(q)*p.L*p.Mp*p.Np;lband+=ulong(q)*p.out_cols;rband+=ulong(q)*p.out_cols;\n    lline+=ulong(q)*p.out_cols;rline+=ulong(q)*p.out_cols;out+=ulong(q)*p.out_cols*p.out_cols;')
+# The host proves every line has exactly one band. Keep the existing rounded
+# single-band expression; omit the unreachable multi-band accumulator path.
+cut=rec.index('    Line li=lline[row],lj=rline[col];')
+rec=rec[:cut]+'    device Number<N>& o=out[ulong(row)*p.out_stride+col];o=rounded(X,exponent_type(a.lo)+b.lo-2*(32*N-1),sign,o);\n}\n'
+for name,body in [('left',left),('product',product),('rec',rec)]:
+    assert 'global [[' in body,name
+header='// Private grouped single-band SYRK experiment; generated by benchmarks/experiments/grouped_exact/generate_kernels.py\n// Base linalg.metal SHA256: '+hashlib.sha256(s.encode()).hexdigest()+'\n'
+(root/'src/linalg_grouped.metal').write_text(header+preamble+control+left+product+rec)
