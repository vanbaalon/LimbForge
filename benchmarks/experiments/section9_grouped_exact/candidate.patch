+}}
+template<int N=2> BlockedTrialsInfo width(int bits,Engine& e,Linalg& la,const CholeskyTrials& s,O a,O d,O mu,O l,O status,const FactorOptions& o,const Scratch& scratch,bool lookahead,bool grouped){
