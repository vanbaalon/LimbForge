+        for(std::size_t i=0;i<n;++i)for(std::size_t j=0;j<n;++j){auto q=i*n+j;if(i>=j)mpfr_set(L[off+q],input[q],MPFR_RNDN);else mpfr_set_zero(L[off+q],1);}
