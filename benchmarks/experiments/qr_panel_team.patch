+// Spin barrier for a team of `size` threads (the panel team): the last arrival releases the others.
+struct Team {
+    std::atomic<unsigned> count{0},gen{0};const unsigned size;
+    explicit Team(unsigned n):size(n){}
+    void sync(){const unsigned g=gen.load(std::memory_order_acquire);
+        if(count.fetch_add(1,std::memory_order_acq_rel)+1==size){count.store(0,std::memory_order_relaxed);gen.fetch_add(1,std::memory_order_release);return;}
+        for(unsigned s=0;gen.load(std::memory_order_acquire)==g;)if(++s>256)std::this_thread::yield();}
+};
+// f(i) for i in [0, total), claimed in chunks from a shared counter.
+template<class F> void claim(std::atomic<std::size_t>& next,std::size_t total,std::size_t chunk,F f){
+    for(std::size_t i;(i=next.fetch_add(chunk))<total;)for(std::size_t e=std::min(total,i+chunk);i<e;++i)f(i);}
 }
