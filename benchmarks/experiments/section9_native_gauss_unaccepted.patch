+template<int B> std::vector<C<B>> gauss_reference(const StridedGemm& s,const std::vector<C<B>>& a,const std::vector<C<B>>& b,std::vector<C<B>> out){
+    for(std::size_t t=0;t<s.count;++t)for(std::size_t i=0;i<s.m;++i)for(std::size_t j=0;j<s.n;++j){
+        C<B> sum=s.accumulate?out[t*s.stride_c+i*s.n+j]:C<B>{zero<B/32>(),zero<B/32>()};
